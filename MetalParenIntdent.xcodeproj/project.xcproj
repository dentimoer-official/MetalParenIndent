{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "MetalParenIntdent",
      "target-membership": [
        "MetalParenIntdent",
      ],
      "membership-exceptions": [
        {
          "target": "MetalParenIntdent",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "MetalParenIndentExtension",
      "target-membership": [
        "MetalParenIndentExtension",
      ],
      "membership-exceptions": [
        {
          "target": "MetalParenIndentExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/Cocoa.framework", "target-membership": [ "MetalParenIndentExtension/frameworks" ] },
        {
          "path": "<DEVELOPER>/Library/Frameworks/XcodeKit.framework",
          "target-membership": [
            "MetalParenIndentExtension/frameworks",
            { "build-phase": "MetalParenIndentExtension/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/MetalParenIndent.app", "id": "EBE0782830ABEF4D00C3A234", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/MetalParenIndentExtension.appex", "id": "EBE0783930ABEF9400C3A234", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "MetalParenIntdent/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    }, {
      "kind": "folder",
      "path": "Shared",
      "target-membership": [
        "MetalParenIndentExtension",
      ],
      "membership-exceptions": [
        {
          "target": "MetalParenIntdent",
          "inclusions": [
            "IndentEngine.swift",
          ],
        },
      ],
    },
  ],
  "targets": [
    {
