        "INFOPLIST_KEY_NSHumanReadableCopyright": "© 2026 dentimoer",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "27.0",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.dentimoer.MetalParenIntdent",
        "PRODUCT_NAME": "MetalParenIndent",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "MetalParenIndentExtension",
      "id": "EBE0783830ABEF9400C3A234",
      "product": "Products/MetalParenIndentExtension.appex",
      "product-type": "xcode-extension",
      "build-phases": [
