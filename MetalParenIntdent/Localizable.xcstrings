{
  "sourceLanguage" : "en",
  "strings" : {
    "Assign Shortcuts" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키 지정"
          }
        }
      }
    },
    "Clean bracket indentation for Metal shaders in Xcode." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode에서 Metal 셰이더의 괄호 들여쓰기를 깔끔하게 정리합니다."
          }
        }
      }
    },
    "Copy Result" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과 복사"
          }
        }
      }
    },
    "Enable the Extension" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장 켜기"
          }
        }
      }
    },
    "Fixes bracket indentation in the current file or selection. Suggested: ⌃⌥⌘I" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 파일이나 선택한 줄의 괄호 들여쓰기를 정리합니다. 추천: ⌃⌥⌘I"
          }
        }
      }
    },
    "In Xcode, open Settings → Key Bindings and search for \"MetalParenIndent\"." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode에서 Settings → Key Bindings를 열고 \"MetalParenIndent\"를 검색하세요."
          }
        }
      }
    },
    "Inserts a newline with block indentation after ( or [. Suggested: ⇧↩" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "( 나 [ 뒤에서 한 단계 들여쓴 줄바꿈을 넣습니다. 추천: ⇧↩"
          }
        }
      }
    },
    "Open a .metal file and choose Editor → MetalParenIndent, or press your shortcut. Other file types are left untouched." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".metal 파일을 열고 Editor → MetalParenIndent를 선택하거나 지정한 단축키를 누르세요. 다른 종류의 파일은 건드리지 않습니다."
          }
        }
      }
    },
    "Open System Settings" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 열기"
          }
        }
      }
    },
    "Original" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본"
          }
        }
      }
    },
    "Paste Metal code on the left. The fixed result appears on the right." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽에 Metal 코드를 붙여넣으면 오른쪽에 정리된 결과가 나타납니다."
          }
        }
      }
    },
    "Preview" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기"
          }
        }
      }
    },
    "Quit Xcode completely (⌘Q) and open it again so it loads the extension." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode가 확장을 불러오도록 완전히 종료(⌘Q)한 뒤 다시 실행하세요."
          }
        }
      }
    },
    "Reset Sample" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예제로 되돌리기"
          }
        }
      }
    },
    "Restart Xcode" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode 다시 시작"
          }
        }
      }
    },
    "Result" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과"
          }
        }
      }
    },
    "Set Up" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정하기"
          }
        }
      }
    },
    "Setup" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정"
          }
        }
      }
    },
    "Try It" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용해 보기"
          }
        }
      }
    },
    "Turn on MetalParenIndent under Xcode Source Editor in System Settings." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정의 Xcode Source Editor에서 MetalParenIndent를 켜세요."
          }
        }
      }
    },
    "Use It" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용하기"
          }
        }
      }
    },
    "Use the sidebar to set up the extension or try it on your own code." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사이드바에서 확장을 설정하거나 직접 코드로 사용해 보세요."
          }
        }
      }
    },
    "Welcome" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "환영합니다"
          }
        }
      }
    },
    "Welcome to MetalParenIndent" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetalParenIndent에 오신 것을 환영합니다"
          }
        }
      }
    },
    "With MetalParenIndent" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetalParenIndent 적용"
          }
        }
      }
    },
    "Xcode aligns wrapped parameters under the opening parenthesis, which pushes them far to the right. MetalParenIndent indents them by one level instead." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode는 줄바꿈한 인자를 여는 괄호 위치에 맞춰 정렬해서 코드가 오른쪽으로 멀리 밀려납니다. MetalParenIndent는 대신 한 단계만 들여씁니다."
          }
        }
      }
    },
    "Xcode default" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode 기본"
          }
        }
      }
    }
  },
  "version" : "1.0"
}